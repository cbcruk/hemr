  "inputSchema": {
    "check": "isNightForAd | manualSendCheck | scheduledSendWindow | contactRuleWindow",
    "isNightForAd": {
      "atKst": "HH:mm in Asia/Seoul",
      "messageType": "'광고'|'알림'|null"
    },
    "manualSendCheck": {
      "form": "{ messageType, reservedAt?: ISO }",
      "nowKst": "HH:mm"
    },
    "scheduledSendWindow": {
      "messageType": "'ad'|'info'",
      "hours": "0-23",
      "minutes": "0-55 step 5"
    },
    "contactRuleWindow": {
      "rule": "{ 기준, 메시지유형: 'ad'|'info', 발송시, 발송분 }"
    }
  },
