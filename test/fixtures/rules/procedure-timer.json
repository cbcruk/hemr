  "inputSchema": {
    "check": "mapServerProcedure | tick | startTreatment | setDuration | adjustTimer | defaults | groupDuration | timerEndNotification",
    "mapServerProcedure": {
      "procedure": "server row { 치료실시술Id, 상태: 'pending'|'running'|'done', 담당구분, duration_sec, 타이머종료여부, 시작일시 ISO|null }",
      "nowMs": "epoch ms, already corrected by serverNow offset"
    },
    "tick": {
      "procedures": "local rows { id, 상태, duration_sec, 시작일시, remaining_sec }",
      "nowMs": "epoch ms"
    },
    "startTreatment": {
      "procedures": "local rows of one visit",
      "targetId": "string",
      "nowIso": "ISO"
    },
    "setDuration": {
      "procedure": "local row",
      "newSec": "number",
      "nowMs": "epoch ms"
    },
    "adjustTimer": {
      "procedure": "local row",
      "delta": "seconds (+/-)",
      "nowMs": "epoch ms"
    },
    "groupDuration": {
      "items": "[{ duration_sec }]"
    },
    "timerEndNotification": {
      "베드번호": "number",
      "환자명": "string",
      "items": "[{ 시술Id, 카테고리, 시작일시, duration_sec }]"
    }
  },
