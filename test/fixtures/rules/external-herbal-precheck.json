  "inputSchema": {
    "check": "precheckGate | herbLineQuantity | packBasedQuantity | allocatePaymentMethods | normalizeQuote | duplicatePaymentRisk",
    "precheckGate": {
      "precheckResult": "{ kind: 'resolve'|'reject'|'none', value: value returned by postOcsv2Precheck (= response.data.result) or error message }"
    },
    "herbLineQuantity": {
      "첩당용량g": "number|string",
      "첩수": "number|string"
    },
    "packBasedQuantity": {
      "팩수": "number",
      "과금팩수": "number|null"
    },
    "allocatePaymentMethods": {
      "methods": "[{ 결제수단유형: '예치금카드'|'일반카드', 입력금액 }]",
      "serverPaymentAmount": "number|null (quote paymentAmount)"
    },
    "normalizeQuote": {
      "금액항목": "object|null"
    },
    "duplicatePaymentRisk": {
      "error": "{ isAxiosError, response.data.message }"
    }
  },
