  "inputSchema": {
    "check": "arbitraryFormula | packageMix | packageItemAmount | nonBenefitAmount | nonBenefitAmountUnclamped | nonBenefitRegister | treatmentRoom | roomCount | personalFormulaName",
    "arbitraryFormula": {
      "처방명": "string",
      "구성약재": "[{ 상한금액: number (unit price per 규격), 사용량: number|string (g), 규격: number (기준용량 g) }]"
    },
    "packageMix": {
      "items": "[{ 과세구분: '면세'|'별도'|'포함'|null }]",
      "candidate": "optional { 과세구분 }"
    },
    "packageItemAmount": {
      "단가": "number",
      "과세구분": "string",
      "일투여량": "number",
      "투약일수": "number"
    },
    "nonBenefitAmount": {
      "input": "string as typed (commas allowed)",
      "과세구분": "'면세'|'별도'|'포함'"
    },
    "nonBenefitAmountUnclamped": {
      "rawValue": "string digits",
      "과세구분": "string"
    },
    "nonBenefitRegister": {
      "처방명": "string",
      "코드": "string without 비 prefix",
      "rawValue": "string",
      "existingItems": "[{ 처방명, 코드 (with 비 prefix) }]"
    },
    "treatmentRoom": {
      "치료실명": "string",
      "베드수": "string (input value)",
      "기존베드수": "string|undefined (edit mode)",
      "id": "string ('' on create)",
      "existingRooms": "[{ 치료실Id, 치료실명 }]"
    },
    "roomCount": {
      "existingRoomCount": "number"
    },
    "personalFormulaName": {
      "처방명": "string",
      "existingNames": "string[] in server order"
    }
  },
